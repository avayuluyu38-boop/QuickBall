<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the network. Screen, input, notification text and the app list come
         from the host's accessibility service and from permissions the app already
         declares. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />
    <!-- Self-update through the system installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- The foreground service notification is hidden while this is not granted. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Cleartext is only for a plain-HTTP relay during development; the default one is TLS. -->
    <application android:usesCleartextTraffic="${cleartext}">

        <!-- Starts the module without touching the host's Application class. -->
        <provider
            android:name=".SyncInitProvider"
            android:authorities="${applicationId}.quickball-sync"
            android:enabled="true"
            android:exported="false"
            android:initOrder="100" />

        <!-- Self-update: hands a downloaded APK to the system installer. -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.quickball-update"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/update_paths" />
        </provider>

        <!-- Codes that arrive as notifications ride the accessibility stream. -->

        <!-- Keeps the channel alive without depending on the ball being on. -->
        <service
            android:name=".SyncService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Reconnect after unlock and after an update. -->
        <receiver
            android:name=".SyncWakeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
