<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Only the network. Screen, input and the app list come from the host's
         accessibility service and from permissions the app already declares. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC" />

    <!-- Cleartext is only for a plain-HTTP relay during development; the default one is TLS. -->
    <application android:usesCleartextTraffic="${cleartext}">

        <!-- Starts the module without touching the host's Application class. -->
        <provider
            android:name=".SyncInitProvider"
            android:authorities="${applicationId}.quickball-sync"
            android:enabled="true"
            android:exported="false"
            android:initOrder="100" />

        <!-- Codes that arrive as notifications. Optional toggle for the user. -->
        <service
            android:name=".SyncNotificationListener"
            android:enabled="true"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Keeps the channel alive without depending on the ball being on. -->
        <service
            android:name=".SyncService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="dataSync" />

        <!-- Reconnect after unlock and after an update. -->
        <receiver
            android:name=".SyncWakeReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

    </application>
</manifest>
